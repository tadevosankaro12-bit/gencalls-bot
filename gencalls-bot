def parse_phone(text):
    if not text: return None
    digits = "".join(filter(str.isdigit, text.strip()))
    if len(digits) == 10 and digits.startswith("9"): return "7" + digits
    if len(digits) == 11 and digits.startswith("8"): return "7" + digits[1:]
    return digits

